<%- include('../cabecalho')%>
    <div>
        <h3>Paleontologistas</h3>
        <p>Maiores paleontólogos da história da descoberta dos fosséis de dinossauro</p>
        <a href="/paleontologo/add">+ Novo Paleontólogo</a>

        <table>
            <tr>
                <td>
                    <h3>Nome</h3>
                </td>
                <td>
                    <h3>Nascimento</h3>
                </td>
                <td>
                    <h3>Descoberta</h3>
                </td>
            </tr>
            <%paleontologos.forEach(paleontologo=>{%>
                <tr>
                    <td>
                        <p>
                            <%=paleontologo.nome%>
                        </p>
                    </td>
                    <td>
                        <p>
                            <%=paleontologo.nascimento%>
                        </p>
                    </td>
                    <td>
                        <p>
                            <%=paleontologo.descoberta%>
                        </p>
                    </td>
                    <td>
                        <a href="/paleontologo/upd/<%=paleontologo.id%>">✏️</a>
                        <a href="/paleontologo/del/<%=paleontologo.id%>">🗑️</a>
                    </td>
                </tr>
                <%})%>
        </table>
    </div>
    </body>

    </html>